<idea-plugin>
    <id>com.l10n.editor.jetbrains</id>
    <name>L10n Editor for JetBrains</name>
    <vendor email="support@example.com" url="https://github.com/omigaZen/L10nEditorJetBrains">L10n Editor</vendor>

    <description><![CDATA[
    L10n localization file editor plugin for JetBrains IDEs with AI translation support.

    Features:
    - TSV-based l10n file format (*.l10n.tsv)
    - AI translation (OpenAI, Claude, Baidu)
    - Inlay hints showing "AI:" prefix for AI-translated cells
    - C# code generation
    - Editor toolbar with common operations
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- File Type -->
        <fileType name="L10nFile" implementationClass="com.l10n.plugin.L10nFileType"
                  fieldName="INSTANCE" language="L10n" extensions="l10n.tsv"/>

        <!-- Editor Notification - Toolbar above editor -->
        <editorNotificationProvider implementation="com.l10n.plugin.editor.L10nEditorNotificationProvider"/>

        <!-- Settings -->
        <applicationConfigurable parentId="tools" instance="com.l10n.plugin.settings.L10nSettingsConfigurable"
                                 id="com.l10n.plugin.settings.L10nSettingsConfigurable"
                                 displayName="L10n Editor"/>

        <!-- Application Service -->
        <applicationService serviceImplementation="com.l10n.plugin.settings.L10nSettings"/>
    </extensions>

    <actions>
        <!-- New File Action -->
        <action id="L10n.NewFile" class="com.l10n.plugin.actions.NewL10nFileAction" text="L10n File">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFile"/>
        </action>
    </actions>
</idea-plugin>
